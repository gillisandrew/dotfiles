#!/usr/bin/env bash
# Claude Code status line: dir, git, model and effort, context %, prompt cache
# time left, 5-hour usage, lines changed, cost.
# Reads the session JSON on stdin; see `statusLine` in ~/.claude/settings.json.
# Claude Code redraws it on session activity, so the cache countdown can lag while idle.

set -euo pipefail

# Unit separator, not tab: bash collapses consecutive tabs and would shift empty fields.
IFS=$'\x1f' read -r dir model effort fast context cache_warm cache_expires usage_5h reset_5h added removed cost < <(jq -r '[
  (.workspace.current_dir // .cwd // ""),
  (.model.display_name // ""),
  (.effort.level // ""),
  (.fast_mode // false),
  (.context_window.used_percentage // ""),
  (.prompt_cache.warm | if . == null then "" else . end),
  (.prompt_cache.expires_at // ""),
  (.rate_limits.five_hour.used_percentage // ""),
  (.rate_limits.five_hour.resets_at // ""),
  (.cost.total_lines_added // 0),
  (.cost.total_lines_removed // 0),
  (.cost.total_cost_usd // "")
] | map(tostring) | join("\u001f")')

reset=$'\e[0m' dim=$'\e[2m'
cyan=$'\e[36m' magenta=$'\e[35m' blue=$'\e[34m' green=$'\e[32m' yellow=$'\e[33m' red=$'\e[31m'

# Nerd Font icons in Ghostty (FiraCode Nerd Font Mono), text labels elsewhere.
# CLAUDE_STATUS_ICONS=1 or 0 overrides the detection.
use_icons="${CLAUDE_STATUS_ICONS:-}"
if [[ -z "$use_icons" ]]; then
  use_icons=0
  [[ "${TERM_PROGRAM:-}" == ghostty || "${TERM:-}" == xterm-ghostty ]] && use_icons=1
fi
if [[ "$use_icons" == 1 ]]; then
  i_dir=' '
  i_branch=' '
  i_model='󰚩 '
  i_fast=''
  i_context='󰍛 '
  i_cache='󰔟 '
  i_usage='󰓅 '
  i_diff=' '
  i_cost=' '
else
  i_dir=''
  i_branch=''
  i_model=''
  i_fast='⚡'
  i_context=''
  i_cache='cache '
  i_usage='5h '
  i_diff=''
  i_cost='$'
fi

# Green below 50, yellow from 50, red from 80.
level_color() {
  if (( $1 >= 80 )); then printf '%s' "$red"
  elif (( $1 >= 50 )); then printf '%s' "$yellow"
  else printf '%s' "$green"
  fi
}

clock() {
  date -d "@$1" +%H:%M 2>/dev/null || /bin/date -r "$1" +%H:%M
}

parts=()

# Directory: repo name plus path inside it, else the last two components.
if root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)"; then
  label="$(basename "$root")${dir#"$root"}"
else
  label="${dir/#$HOME/~}"
  [[ "$label" == */*/* ]] && label="${label#"${label%/*/*}"/}"
fi
parts+=("${cyan}${i_dir}${label}${reset}")

# Git: branch, ahead/behind, then staged (+), modified (!), untracked (?).
if [[ -n "${root:-}" ]]; then
  branch="" ahead=0 behind=0 staged=0 modified=0 untracked=0
  while IFS= read -r line; do
    case "$line" in
      "# branch.head "*) branch="${line#\# branch.head }" ;;
      "# branch.ab "*) read -r _ _ a b <<<"$line"; ahead="${a#+}"; behind="${b#-}" ;;
      "1 "*|"2 "*)
        xy="${line:2:2}"
        [[ "${xy:0:1}" != "." ]] && staged=1
        [[ "${xy:1:1}" != "." ]] && modified=1 ;;
      "? "*) untracked=1 ;;
    esac
  done < <(git -C "$dir" --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)
  flags=""
  (( ahead > 0 )) && flags+="⇡${ahead}"
  (( behind > 0 )) && flags+="⇣${behind}"
  (( staged )) && flags+="+"
  (( modified )) && flags+="!"
  (( untracked )) && flags+="?"
  parts+=("${magenta}${i_branch}${branch}${reset}${flags:+ ${red}${flags}${reset}}")
fi

# Model, effort, fast mode.
if [[ -n "$model" ]]; then
  segment="${blue}${i_model}${model}${reset}"
  [[ -n "$effort" ]] && segment+=" ${dim}${effort}${reset}"
  [[ "$fast" == "true" ]] && segment+=" ${yellow}${i_fast}${reset}"
  parts+=("$segment")
fi

[[ -n "$context" ]] && parts+=("$(level_color "$context")${i_context}${context}%${reset}")

# Prompt cache: minutes until it expires; yellow under 10, red once cold.
if [[ -n "$cache_warm" ]]; then
  left=0
  [[ "$cache_warm" == "true" && -n "$cache_expires" ]] && left=$(( (cache_expires - $(date +%s)) / 60 ))
  if (( left <= 0 )); then
    parts+=("${red}${i_cache}cold${reset}")
  elif (( left < 10 )); then
    parts+=("${yellow}${i_cache}${left}m${reset}")
  else
    parts+=("${green}${i_cache}${left}m${reset}")
  fi
fi

# 5-hour usage; reset time once past half.
if [[ -n "$usage_5h" ]]; then
  segment="$(level_color "$usage_5h")${i_usage}${usage_5h}%${reset}"
  (( usage_5h >= 50 )) && [[ -n "$reset_5h" ]] && segment+=" ${dim}↻$(clock "$reset_5h")${reset}"
  parts+=("$segment")
fi

(( added > 0 || removed > 0 )) && parts+=("${i_diff}${green}+${added}${reset} ${red}−${removed}${reset}")

[[ -n "$cost" ]] && parts+=("${dim}${i_cost}$(printf '%.2f' "$cost")${reset}")

sep=" ${dim}·${reset} "
out="${parts[0]}"
for part in "${parts[@]:1}"; do out+="${sep}${part}"; done
printf '%s\n' "$out"
