#!/bin/sh
# Detect dotfiles target environment.
# Source this from shell configs: . "$HOME/.local/bin/dotfiles-env"
#
# Exports:
#   DOTFILES_OS  — "macos" or "linux"
#   DOTFILES_ENV — "macos", "devcontainer", "local-linux", or "remote-linux"
#
# local-linux  = Linux with a desktop environment installed (laptop/workstation)
# remote-linux = headless Linux (bare server reached over SSH)

# Short-circuit if already sourced (zshenv → zprofile → zshrc)
[ -n "$DOTFILES_OS" ] && return 0 2>/dev/null || true

case "$(uname -s)" in
  Darwin) DOTFILES_OS="macos" ;;
  *)      DOTFILES_OS="linux" ;;
esac

if [ -n "${REMOTE_CONTAINERS:-}" ] || [ -n "${CODESPACES:-}" ] || [ -f /.dockerenv ]; then
  DOTFILES_ENV="devcontainer"
elif [ "$DOTFILES_OS" = "linux" ] && { [ -d /usr/share/wayland-sessions ] || [ -d /usr/share/xsessions ]; }; then
  DOTFILES_ENV="local-linux"
elif [ "$DOTFILES_OS" = "linux" ]; then
  DOTFILES_ENV="remote-linux"
else
  DOTFILES_ENV="macos"
fi

export DOTFILES_OS DOTFILES_ENV
