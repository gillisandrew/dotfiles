if [ "$DOTFILES_ENV" = "macos" ]; then
  [ -S "$HOME/.bitwarden-ssh-agent.sock" ] && export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
fi

[ "$(command -v curlie)" ] && alias curl="curlie"
[ "$(command -v bat)" ] && alias cat="bat"

alias ..='cd ..'
alias ...='cd ../..'
export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad

alias ls='ls --color=auto -G'
alias la='ls -la'

alias c='claude --model opus'
alias ch='claude --model haiku'
alias cs='claude --model sonnet'
alias ch-commit='claude --model haiku --dangerously-skip-permissions --print '\''Stage and commit pending git changes in one or more atomic commits. If a precommit check fails, report back to the user. Do not attempt to fix. For each commit out put the following, seperated by `---`:

## <conventional commit type>: <subject>

**Commit:** `<short sha>`

**Files:**
- <path> (<added/modified/deleted>)

**Summary:** <one sentence describing what changed and why>
'\'' | glow -'
alias cs-docs-gen='claude --model sonnet --system-prompt '\''Generate API docs in OpenAPI 3.0 format'\'' --allowed-tools '\''Read,Grep,Write'\'''
alias cs-sec-scan='claude --model sonnet --system-prompt '\''Security audit focusing on OWASP Top 10'\'' --allowed-tools '\''Read,Grep'\'''
alias cs-test-gen='claude --model sonnet --system-prompt '\''Generate comprehensive tests with full coverage'\'''
alias c-claude-md='claude --model opus --system-prompt '\''When writing or updating CLAUDE.md: follow RED-GREEN-REFACTOR. RED — think through hypothetical scenarios: what would an agent get wrong in this project without the doc? GREEN — write minimal CLAUDE.md addressing only those specific failures. REFACTOR — dispatch 2-3 parallel subagents with realistic project tasks, cut every line they did not need, strengthen gaps, iterate until every line earns its keep or is cut.'\'' '\''Use the zw:writing-claude-md skill to update or create the CLAUDE.md file in this repo.'\'''
alias init='chezmoi init --apply'

alias fallows="pnpm dlx fallow --summary"


. "$HOME/.local/share/shell/functions.sh"

# Portless: stable .localhost URLs for local dev
export PORTLESS_PORT=443
export PORTLESS_HTTPS=1

export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
export CARAPACE_MATCH=1

_shell_cache_dir="$HOME/.cache/shell-init"
[ -d "$_shell_cache_dir" ] || mkdir -p "$_shell_cache_dir"

_cached_init() {
  # Usage: _cached_init <cache-file> <command...>
  local cache="$_shell_cache_dir/$1"; shift
  if [ ! -f "$cache" ]; then
    "$@" > "$cache" 2>/dev/null
  fi
  source "$cache"
}

# CLAUDE EXPERIMENTAL FLAGS
export CLAUDE_CODE_FORK_SUBAGENT=1
export CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1
if [ -z "$CLAUDECODE" ]; then
  [ -z "$DISABLE_CARAPACE" ] && [ "$(command -v carapace)" ] && _cached_init carapace.{{ . }} carapace _carapace {{ . }}
{{ if eq . "zsh" }}  [ -z "$DISABLE_FZF" ] && [ "$(command -v fzf)" ] && _cached_init fzf.zsh fzf --zsh
{{ end }}  [ -z "$DISABLE_STARSHIP" ] && [ "$(command -v starship)" ] && _cached_init starship.{{ . }} starship init {{ . }}
  [ -z "$DISABLE_ATUIN" ] && [ "$(command -v atuin)" ] && _cached_init atuin.{{ . }} atuin init {{ . }}
  [ -z "$DISABLE_ZOXIDE" ] && [ "$(command -v zoxide)" ] && _cached_init zoxide.{{ . }} zoxide init {{ . }} --cmd cd
fi

unset _shell_cache_dir
unset -f _cached_init
{{ if eq . "zsh" }}
# Vite+ completions: the env file only registers compdef if compinit has already
# run, which is not the case when .zprofile sources it. Re-source here (PATH dedupes).
[ -f "$HOME/.vite-plus/env" ] && . "$HOME/.vite-plus/env"
{{ end }}
. "$HOME/.local/bin/dotfiles-motd-fast"
